# En local, le navigateur appelle l’API Nest directement.
NUXT_PUBLIC_API_BASE=http://localhost:3001/api

# Sur Netlify, ne pas mettre localhost.
# Soit l’adresse publique complète :
# NUXT_PUBLIC_API_BASE=https://api.exemple.com/api
# Soit laisser vide et définir l’origine de l’API (sans /api) :
# API_ORIGIN=https://api.exemple.com
# NUXT_API_ORIGIN=https://api.exemple.com

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cv_generator?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=3001
# Plusieurs origines possibles, séparées par des virgules
CORS_ORIGIN="http://localhost:3000"
# Autorise les fronts déployés sur Netlify (*.netlify.app)
CORS_ALLOW_NETLIFY="true"
# Comptes promus super admin à l'inscription et au démarrage (emails séparés par des virgules)
ADMIN_EMAILS=""
NODE_ENV=development

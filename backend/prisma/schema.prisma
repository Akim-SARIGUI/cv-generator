generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  resumes Resume[]

  @@map("users")
}

model Resume {
  id        String   @id @default(cuid())
  title     String   @default("Mon CV")
  template  String   @default("eu")
  locale    String   @default("fr")
  /// Clés de sections activées + titres custom optionnels
  sections  Json     @default("{\"profile\":true,\"objective\":false,\"experience\":true,\"education\":true,\"skills\":true,\"languages\":true,\"certifications\":false,\"awards\":false,\"projects\":false,\"interests\":false,\"references\":false}")
  isDefault Boolean  @default(true) @map("is_default")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  personal    PersonalInfo?
  experiences Experience[]
  educations  Education[]
  skills      Skill[]
  extras      ExtraEntry[]

  @@index([userId])
  @@map("resumes")
}

model PersonalInfo {
  id          String  @id @default(cuid())
  resumeId    String  @unique @map("resume_id")
  fullName    String  @map("full_name")
  email       String?
  phone       String?
  address     String?
  linkedinUrl String? @map("linkedin_url")
  githubUrl   String? @map("github_url")
  websiteUrl  String? @map("website_url")
  summary     String?
  objective   String?
  photoUrl    String? @map("photo_url")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("personal_infos")
}

model Experience {
  id          String    @id @default(cuid())
  resumeId    String    @map("resume_id")
  jobTitle    String    @map("job_title")
  company     String
  location    String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  currentJob  Boolean   @default(false) @map("current_job")
  description String?
  sortOrder   Int       @default(0) @map("sort_order")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("experiences")
}

model Education {
  id               String    @id @default(cuid())
  resumeId         String    @map("resume_id")
  degree           String
  institution      String
  location         String?
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  currentEducation Boolean   @default(false) @map("current_education")
  description      String?
  sortOrder        Int       @default(0) @map("sort_order")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("educations")
}

enum SkillCategory {
  TECHNICAL
  SOFT
  LANGUAGE
  TOOL
  OTHER
}

model Skill {
  id          String        @id @default(cuid())
  resumeId    String        @map("resume_id")
  name        String
  category    SkillCategory @default(TECHNICAL)
  proficiency Int           @default(3)
  sortOrder   Int           @default(0) @map("sort_order")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("skills")
}

enum ExtraKind {
  CERTIFICATION
  AWARD
  PROJECT
  INTEREST
  REFERENCE
  LANGUAGE
}

model ExtraEntry {
  id          String    @id @default(cuid())
  resumeId    String    @map("resume_id")
  kind        ExtraKind
  title       String
  subtitle    String?
  dateLabel   String?   @map("date_label")
  description String?
  url         String?
  sortOrder   Int       @default(0) @map("sort_order")

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@index([resumeId, kind])
  @@map("extra_entries")
}
